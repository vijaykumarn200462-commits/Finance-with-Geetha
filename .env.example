# ==========================================
# FIREBASE WEB SDK (Client Side)
# ==========================================
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_web_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=geetha-coaching.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=geetha-coaching
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=geetha-coaching.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_web_app_id

# ==========================================
# FIREBASE ADMIN SDK (Server Side Only - NEVER EXPOSE TO CLIENT)
# ==========================================
FIREBASE_PROJECT_ID=geetha-coaching
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@geetha-coaching.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# ==========================================
# INITIAL SETUP & SEED TOKEN (Optional protection for seed/first-admin API)
# ==========================================
ADMIN_SETUP_SECRET=geetha-admin-secret-setup-2026

# ==========================================
# STRIPE INTEGRATION
# ==========================================
STRIPE_SECRET_KEY=sk_test_placeholder_key
STRIPE_WEBHOOK_SECRET=whsec_placeholder_secret
NEXT_PUBLIC_STRIPE_COMMUNITY_PRICE_ID=price_community_monthly
NEXT_PUBLIC_STRIPE_BOOK_PRICE_ID=price_book_single
NEXT_PUBLIC_STRIPE_CHEATSHEETS_PRICE_ID=price_cheatsheets_bundle
NEXT_PUBLIC_STRIPE_WORKFLOW_PRICE_ID=price_workflow_template
NEXT_PUBLIC_STRIPE_CALL_PRICE_ID=price_strategy_call_30min

# ==========================================
# CALENDLY & COMMUNICATIONS
# ==========================================
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/geetha/consultation

# ==========================================
# TRANSACTIONAL EMAIL NOTIFICATIONS (Server Side Only - NEVER EXPOSE TO CLIENT)
# ==========================================
# Primary transactional email provider API Key (Resend: acquire from https://resend.com)
RESEND_API_KEY=re_your_api_key_here

# Notification recipient for client consultation inquiries (defaults to cageethanofficial@gmail.com)
INQUIRY_NOTIFICATION_EMAIL=cageethanofficial@gmail.com

# Verified sender email / domain (e.g. "Finance with Geetha <consultation@yourdomain.com>" or "Finance with Geetha <onboarding@resend.dev>")
INQUIRY_FROM_EMAIL="Finance with Geetha <onboarding@resend.dev>"

# Backward-compatible environment variable fallbacks:
CONTACT_EMAIL_TO=cageethanofficial@gmail.com
RESEND_FROM_EMAIL="Finance with Geetha <onboarding@resend.dev>"

# Optional Alternative: Standard SMTP / Gmail App Password (Nodemailer)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=cageethanofficial@gmail.com
# SMTP_PASS=your_16_character_app_password
# SMTP_FROM="Finance with Geetha <cageethanofficial@gmail.com>"

# ==========================================
# SITE CONFIGURATION
# ==========================================
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ==========================================
# CURRENCY EXCHANGE & GEOLOCATION (Server Side Only - NEVER EXPOSE TO CLIENT)
# ==========================================
# Optional: Pro API key from exchangerate-api.com (if left blank, high-availability live Open Exchange Rates API or curated benchmark rates are used)
EXCHANGE_RATE_API_KEY=
# Optional: Custom endpoint returning JSON rates { rates: { USD: ..., GBP: ... } } relative to INR base
EXCHANGE_RATE_API_URL=
